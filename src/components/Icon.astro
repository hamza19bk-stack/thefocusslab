const isFill = name in FILL;
const markup = isFill ? FILL[name] : STROKE[name];
---

{
  markup && (
    isFill ? (
      <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={markup} />
    ) : (
      <svg
        class={className}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={markup}
      />
    )
  )
}
