---
/**
 * Icon.astro — pictogrammes SVG inline (24×24, currentColor), décoratifs.
 * Usage : <Icon name="calendar" />   (toujours aria-hidden)
 * Les noms utilisés dans src/data/content.ts doivent exister ici ;
 * un nom inconnu ne rend rien (et `npm run check` le signale).
 */
interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}
const { name, class: className, strokeWidth = 1.8 } = Astro.props;

